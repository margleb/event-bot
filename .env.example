BOT_TOKEN=telegram-bot-token
OPENAI_API_KEY=openai-api-key
# Необязательно: по умолчанию используется text-embedding-3-small
EMBEDDING_MODEL=text-embedding-3-small
# Необязательно: час еженедельной отправки по Москве, 0–23
DIGEST_HOUR_MSK=10
# Публичный HTTPS-адрес Telegram Mini App
MINIAPP_URL=https://bot-ams.margleb.ru/r/app
# Сколько секунд действительна подпись запуска Mini App
MINIAPP_AUTH_MAX_AGE_SECONDS=86400
# Telegram ID администраторов через запятую: доступ к /admin и обращениям
ADMIN_TELEGRAM_IDS=123456789
# Необязательно: час ежедневной админ-сводки по Москве, 0–23
ADMIN_DAILY_REPORT_HOUR_MSK=10
